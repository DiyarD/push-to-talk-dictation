# Normalise line endings in the repository; check out with native endings.
* text=auto

# Model weights and audio must never be touched
*.safetensors binary
*.fermion binary
*.wav binary
*.png binary
*.jpg binary
*.ico binary

# Keep shell/batch scripts CRLF so they run on Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf